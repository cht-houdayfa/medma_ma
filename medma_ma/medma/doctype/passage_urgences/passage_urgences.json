{
 "doctype": "DocType",
 "name": "Passage Urgences",
 "module": "MedMa",
 "custom": 0,
 "engine": "InnoDB",
 "autoname": "format:URG-{YYYY}-{#####}",
 "naming_rule": "Expression",
 "title_field": "patient_name",
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": ["patient", "patient_name", "date_arrivee", "mode_arrivee", "col1", "niveau_triage", "statut", "practitioner", "infirmier", "section_motif", "motif", "section_constantes", "tension_systolique", "tension_diastolique", "frequence_cardiaque", "col2", "frequence_respiratoire", "saturation", "temperature", "col3", "glycemie", "score_douleur", "glasgow", "section_prise_en_charge", "date_prise_en_charge", "delai_attente", "col4", "diagnostic", "traitement", "section_sortie", "orientation", "date_sortie", "col5", "consultation", "observations"],
 "fields": [
  {"fieldname": "patient", "label": "Patient", "fieldtype": "Link", "options": "Patient", "reqd": 1, "in_standard_filter": 1},
  {"fieldname": "patient_name", "label": "Nom du patient", "fieldtype": "Data", "fetch_from": "patient.patient_name", "read_only": 1, "in_list_view": 1},
  {"fieldname": "date_arrivee", "label": "Arrivée", "fieldtype": "Datetime", "description": "Laissez vide : l'heure du serveur est utilisée", "in_list_view": 1},
  {"fieldname": "mode_arrivee", "label": "Mode d'arrivée", "fieldtype": "Select", "options": "Par ses propres moyens\nAmbulance\nSAMU\nProtection civile\nTransfert d'un autre établissement\nForces de l'ordre", "default": "Par ses propres moyens"},
  {"fieldname": "col1", "fieldtype": "Column Break"},
  {"fieldname": "niveau_triage", "label": "Niveau de tri", "fieldtype": "Select", "options": "1 - Détresse vitale\n2 - Très urgent\n3 - Urgent\n4 - Moins urgent\n5 - Non urgent", "reqd": 1, "in_standard_filter": 1, "default": "3 - Urgent"},
  {"fieldname": "statut", "label": "Statut", "fieldtype": "Select", "options": "En attente\nEn cours de soins\nEn observation\nTerminé", "default": "En attente", "reqd": 1, "in_standard_filter": 1},
  {"fieldname": "practitioner", "label": "Médecin", "fieldtype": "Link", "options": "Healthcare Practitioner", "in_standard_filter": 1},
  {"fieldname": "infirmier", "label": "Infirmier de tri", "fieldtype": "Link", "options": "User"},
  {"fieldname": "section_motif", "label": "Motif de venue", "fieldtype": "Section Break"},
  {"fieldname": "motif", "label": "Motif / plainte principale", "fieldtype": "Small Text", "reqd": 1},
  {"fieldname": "section_constantes", "label": "Constantes à l'arrivée", "fieldtype": "Section Break"},
  {"fieldname": "tension_systolique", "label": "Tension systolique (mmHg)", "fieldtype": "Int"},
  {"fieldname": "tension_diastolique", "label": "Tension diastolique (mmHg)", "fieldtype": "Int"},
  {"fieldname": "frequence_cardiaque", "label": "Pouls (bpm)", "fieldtype": "Int"},
  {"fieldname": "col2", "fieldtype": "Column Break"},
  {"fieldname": "frequence_respiratoire", "label": "Fréquence respiratoire (/min)", "fieldtype": "Int"},
  {"fieldname": "saturation", "label": "Saturation en O2 (%)", "fieldtype": "Int"},
  {"fieldname": "temperature", "label": "Température (°C)", "fieldtype": "Float", "precision": "1"},
  {"fieldname": "col3", "fieldtype": "Column Break"},
  {"fieldname": "glycemie", "label": "Glycémie (g/L)", "fieldtype": "Float", "precision": "2"},
  {"fieldname": "score_douleur", "label": "Douleur (0 à 10)", "fieldtype": "Int"},
  {"fieldname": "glasgow", "label": "Score de Glasgow (3 à 15)", "fieldtype": "Int"},
  {"fieldname": "section_prise_en_charge", "label": "Prise en charge", "fieldtype": "Section Break"},
  {"fieldname": "date_prise_en_charge", "label": "Prise en charge à", "fieldtype": "Datetime", "read_only": 1},
  {"fieldname": "delai_attente", "label": "Délai d'attente (min)", "fieldtype": "Int", "read_only": 1},
  {"fieldname": "col4", "fieldtype": "Column Break"},
  {"fieldname": "diagnostic", "label": "Diagnostic", "fieldtype": "Small Text"},
  {"fieldname": "traitement", "label": "Soins et traitement", "fieldtype": "Small Text"},
  {"fieldname": "section_sortie", "label": "Sortie", "fieldtype": "Section Break"},
  {"fieldname": "orientation", "label": "Orientation", "fieldtype": "Select", "options": "\nRetour à domicile\nHospitalisation\nTransfert vers un autre établissement\nSortie contre avis médical\nDécès", "depends_on": "eval:doc.statut=='Terminé'", "mandatory_depends_on": "eval:doc.statut=='Terminé'", "in_list_view": 1},
  {"fieldname": "date_sortie", "label": "Sortie à", "fieldtype": "Datetime", "read_only": 1},
  {"fieldname": "col5", "fieldtype": "Column Break"},
  {"fieldname": "consultation", "label": "Consultation liée", "fieldtype": "Link", "options": "Patient Encounter", "read_only": 1},
  {"fieldname": "observations", "label": "Observations", "fieldtype": "Small Text"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "report": 1, "export": 1},
  {"role": "Physician", "read": 1, "write": 1, "create": 1, "print": 1, "email": 1, "report": 1},
  {"role": "Nursing User", "read": 1, "write": 1, "create": 1, "print": 1, "report": 1},
  {"role": "Healthcare Administrator", "read": 1, "create": 1, "write": 1, "print": 1, "report": 1}
 ]
}
