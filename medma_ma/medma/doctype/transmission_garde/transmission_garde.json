{
 "doctype": "DocType",
 "name": "Transmission Garde",
 "module": "MedMa",
 "custom": 0,
 "engine": "InnoDB",
 "autoname": "format:TRG-{YYYY}-{#####}",
 "naming_rule": "Expression",
 "track_changes": 1,
 "title_field": "libelle",
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": ["date_garde", "equipe", "service", "col1", "infirmier_sortant", "infirmier_entrant", "libelle", "section_patients", "patients", "section_gen", "remarques"],
 "fields": [
  {"fieldname": "date_garde", "label": "Date", "fieldtype": "Date", "default": "Today", "reqd": 1, "in_list_view": 1},
  {"fieldname": "equipe", "label": "Équipe sortante", "fieldtype": "Select", "options": "Matin\nAprès-midi\nNuit", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "service", "label": "Service", "fieldtype": "Select", "options": "Urgences\nHospitalisation\nConsultations", "default": "Urgences", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "col1", "fieldtype": "Column Break"},
  {"fieldname": "infirmier_sortant", "label": "Infirmier sortant", "fieldtype": "Link", "options": "User", "reqd": 1},
  {"fieldname": "infirmier_entrant", "label": "Infirmier entrant", "fieldtype": "Link", "options": "User"},
  {"fieldname": "libelle", "label": "Libellé", "fieldtype": "Data", "read_only": 1},
  {"fieldname": "section_patients", "label": "Patients", "fieldtype": "Section Break"},
  {"fieldname": "patients", "label": "Transmissions par patient", "fieldtype": "Table", "options": "Transmission Patient"},
  {"fieldname": "section_gen", "label": "Remarques générales", "fieldtype": "Section Break"},
  {"fieldname": "remarques", "label": "Matériel, incidents, consignes du service", "fieldtype": "Small Text"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "report": 1, "export": 1},
  {"role": "Nursing User", "read": 1, "write": 1, "create": 1, "print": 1, "report": 1},
  {"role": "Physician", "read": 1, "print": 1}
 ]
}
